{
  "name": "gymbro-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/ui": "~57.0.26",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.3",
    "expo": "~57.0.32",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.5",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.21",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.30",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.27",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sortables": "^1.10.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "dotenv": "^18.0.9",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "openai": "^7.49.0",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "build:dev": "npx eas-cli@latest build --platform android --profile development",
    "build:preview": "npx eas-cli@latest build --platform android --profile preview",
    "update:preview": "npx eas-cli@latest update --channel preview --platform android --environment preview",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:user": "tsx scripts/e2e-user.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:db": "tsx scripts/test-db.ts",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.ts"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/**/*.d.ts",
      "!src/types/database.ts",
      "!src/test-utils/**"
    ],
    "coverageReporters": [
      "text-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 8,
        "branches": 6,
        "functions": 7,
        "lines": 8
      },
      "./src/lib/": {
        "statements": 94,
        "branches": 98,
        "functions": 98,
        "lines": 93
      }
    }
  },
  "allowScripts": {
    "supabase@2.122.0": true
  }
}
