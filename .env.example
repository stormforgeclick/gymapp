# Copia este archivo a `.env` y ajusta los valores. `.env` no se sube a git.
# Guía completa: docs/empezar.md
#
# Para desarrollar no necesitas claves del proyecto real: usa tu propia base local.
#   npx supabase start -x studio,imgproxy,edge-runtime,logflare,vector,mailpit,realtime,storage-api,supavisor
#   npx supabase status -o env      (muestra API_URL y ANON_KEY)

# Dirección de la API local, vista desde el dispositivo que corre la app:
#   emulador de Android ... http://10.0.2.2:54321
#   teléfono en tu red ..... http://<IP de tu PC>:54321   (ipconfig en Windows, ifconfig en macOS/Linux)
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321

# Valor de ANON_KEY en `npx supabase status -o env`. Es la clave pública de la base local, no un secreto.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Solo para los scripts de mantenimiento (scripts/translate-exercises.ts y scripts/e2e-user.ts).
# No hacen falta para desarrollar. Nunca los pongas como EXPO_PUBLIC_*: todo lo que va en la app se puede extraer.
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
